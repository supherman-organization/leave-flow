# Ports exposés sur la machine hôte
MONGO_PORT=27017
BACKEND_PORT=3000
FRONTEND_PORT=5174

# Base de données (nom d'hôte = nom du service Docker)
MONGO_URI=mongodb://mongo:27017/leaveflow

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d